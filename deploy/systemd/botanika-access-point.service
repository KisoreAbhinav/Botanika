[Unit]
Description=Botanika private Wi-Fi access point
Wants=network-pre.target
After=NetworkManager.service network-pre.target
Before=botanika-backend.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/botanika/botanika.env
WorkingDirectory=/opt/botanika
ExecStart=/usr/bin/python3 /opt/botanika/tools/manage_access_point.py enable
ExecStop=/usr/bin/python3 /opt/botanika/tools/manage_access_point.py disable
TimeoutStartSec=45
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
