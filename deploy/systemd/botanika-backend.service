[Unit]
Description=Botanika FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botanika
Group=botanika
WorkingDirectory=/opt/botanika
EnvironmentFile=/etc/botanika/botanika.env
ExecStart=/opt/botanika/.venv/bin/uvicorn botanika.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

# The process only needs its application tree and its generated temp directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/botanika/data/media/temp
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=false
UMask=0077

[Install]
WantedBy=multi-user.target
