# Botanika Phase 7 AP boundary. Install as /etc/botanika/nftables.conf.
# Keep the interface, subnet, and port synchronized with botanika.env if they
# are changed from the documented defaults.
define botanika_ap_if = "wlan0"
define botanika_ap_net = 192.168.50.0/24
define botanika_api_port = 8000

table inet botanika {
    chain input {
        type filter hook input priority filter; policy accept;

        # A connected client needs only DHCP, DNS, the FastAPI port, and the
        # no-JavaScript landing page served by that same FastAPI port.
        iifname $botanika_ap_if udp dport { 53, 67, 68 } accept
        iifname $botanika_ap_if tcp dport 53 accept
        iifname $botanika_ap_if ip saddr $botanika_ap_net tcp dport $botanika_api_port accept
        iifname $botanika_ap_if drop

        # The wildcard FastAPI listener remains reachable on loopback and the
        # AP, but unrelated interfaces cannot reach its port.
        iifname "lo" tcp dport $botanika_api_port accept
        iifname != $botanika_ap_if tcp dport $botanika_api_port drop
    }

    chain forward {
        type filter hook forward priority filter; policy accept;
        # No AP client traffic is forwarded to an upstream network.
        iifname $botanika_ap_if drop
    }
}
