# Named-tunnel configuration template. The token/credentials are deployment
# state and must stay outside Git.
#
# The hostname route can also be configured in the Cloudflare dashboard. Keep
# this file's service loopback-only if local management is used on the Pi.
tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: /etc/cloudflared/REPLACE_WITH_TUNNEL_UUID.json

ingress:
  - hostname: botanika.example.com
    service: http://127.0.0.1:8080
  - service: http_status:404
