# Botanika network transport environment (private AP optional; Quick Tunnel optional).
# Copy to /etc/botanika/botanika.env, replace the passphrase, and chmod 0600.
# This file is intentionally not loaded by imported tests or create_app(); the
# Phase 7 launchers opt into it explicitly through systemd/environment.

BOTANIKA_NETWORK_ENABLED=true
BOTANIKA_HOST=0.0.0.0
BOTANIKA_PORT=8000
BOTANIKA_LOOPBACK_ONLY=false

# Free, no-account Cloudflare Quick Tunnel. For internet pairing without the
# private AP, use this independent configuration instead:
#   BOTANIKA_NETWORK_ENABLED=false
#   BOTANIKA_HOST=127.0.0.1
#   BOTANIKA_LOOPBACK_ONLY=true
#   BOTANIKA_TUNNEL_ENABLED=true
# Quick Tunnels are for development/testing: random per-process URL, no SLA,
# 200 in-flight request limit, and no SSE. Botanika remote pairing therefore
# uses polling and crop uploads rather than an SSE stream.
BOTANIKA_TUNNEL_ENABLED=false
BOTANIKA_CLOUDFLARED_PATH=/usr/local/bin/cloudflared
# Alternatively set BOTANIKA_CLOUDFLARED_NAME=cloudflared when it is on PATH.
BOTANIKA_CLOUDFLARED_NAME=
BOTANIKA_TUNNEL_STARTUP_TIMEOUT_SECONDS=15

BOTANIKA_AP_INTERFACE=wlan0
BOTANIKA_AP_ADDRESS=192.168.50.1
BOTANIKA_AP_PREFIX_LENGTH=24
BOTANIKA_AP_SSID=Botanika
BOTANIKA_AP_CONNECTION_NAME=botanika-ap
BOTANIKA_AP_HOSTNAME=botanika.home.arpa
BOTANIKA_AP_COUNTRY_CODE=IN
BOTANIKA_AP_STACK=auto

# Replace with a unique 8–63 byte WPA passphrase. Never commit the real value.
BOTANIKA_AP_PASSPHRASE=REPLACE_WITH_A_RANDOM_PRIVATE_PASSPHRASE

# Phase 8 hardware handoff. Leave pins blank when developing without GPIO;
# the /mode/toggle endpoint and keyboard N shortcut remain available.
BOTANIKA_MODE_BUTTON_PIN=
BOTANIKA_SOLO_LED_PIN=
BOTANIKA_NETWORKED_LED_PIN=
BOTANIKA_PAIRED_LED_PIN=
BOTANIKA_GPIO_DEBOUNCE_MS=250
BOTANIKA_PAIRING_TTL_SECONDS=300
BOTANIKA_PAIRING_CODE_LENGTH=8
BOTANIKA_CONTROLLER_HEALTH_TIMEOUT_SECONDS=45
BOTANIKA_MAX_REMOTE_CROP_UPLOAD_BYTES=12582912

# Production state is kept outside the read-only application checkout.
BOTANIKA_DATABASE_PATH=/var/lib/botanika/database/botanika.sqlite
BOTANIKA_TEMP_CROPS_DIR=/var/lib/botanika/temp/phase6-crops
BOTANIKA_DISCOVERIES_DIR=/var/lib/botanika/discoveries
BOTANIKA_BACKUP_DIR=/var/lib/botanika/backups

# Phase 9 optional local assets. Leave defaults when the artifacts are not
# installed; capabilities report them unavailable and typed chat still works.
BOTANIKA_LLM_BACKEND=auto
BOTANIKA_LLM_MODEL_PATH=/opt/botanika/models/llm/botanika.gguf
# Explicitly installed llama.cpp CLI; the application never downloads it.
BOTANIKA_LLAMA_CLI_PATH=/opt/botanika/runtime/llama-b10797/llama-cli
BOTANIKA_LLM_CONTEXT_TOKENS=2048
BOTANIKA_LLM_THREADS=4
BOTANIKA_LLM_BATCH_SIZE=128
BOTANIKA_LLM_TEMPERATURE=0.1
BOTANIKA_LLM_MAX_TOKENS=256
BOTANIKA_LLM_TIMEOUT_SECONDS=20
BOTANIKA_STT_PROVIDER=vosk
BOTANIKA_STT_MODELS_PATH=/opt/botanika/models/stt
BOTANIKA_TTS_PROVIDER=piper
BOTANIKA_TTS_MODELS_PATH=/opt/botanika/models/tts
BOTANIKA_VOICE_MAX_TURN_SECONDS=30
BOTANIKA_VOICE_SHORT_SILENCE_SECONDS=1
BOTANIKA_VOICE_LONG_SILENCE_SECONDS=5
BOTANIKA_WEED_MANIFEST_PATH=/opt/botanika/config/weed/phase9-beta.json
BOTANIKA_WEED_CONFIDENCE=0.35
BOTANIKA_WEED_NMS_IOU=0.45
BOTANIKA_WEED_MAX_UPLOAD_BYTES=12582912
BOTANIKA_WEED_POSITION_MAX_ACCURACY_M=100
