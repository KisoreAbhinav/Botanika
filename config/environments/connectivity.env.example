# Copy to /etc/botanika/botanika.env on the Pi. Do not commit the copied file.
BOTANIKA_APP_NAME=Botanika
BOTANIKA_APP_VERSION=0.1.0
BOTANIKA_ENVIRONMENT=production
BOTANIKA_HOST=127.0.0.1
BOTANIKA_PORT=8000
BOTANIKA_FRONTEND_DIR=/opt/botanika/frontend
BOTANIKA_TEMPORARY_DIR=/opt/botanika/data/media/temp
# 6 MiB request envelope = 5 MiB image cap + multipart/metadata overhead.
BOTANIKA_MAX_REQUEST_BYTES=6291456
BOTANIKA_MAX_IMAGE_BYTES=5242880
BOTANIKA_MAX_IMAGE_PIXELS=20000000
BOTANIKA_MAX_IMAGE_DIMENSION=8192
BOTANIKA_IDEMPOTENCY_TTL_SECONDS=600
BOTANIKA_RECEIPT_RATE_LIMIT=30
BOTANIKA_RECEIPT_RATE_WINDOW_SECONDS=60
BOTANIKA_WS_HEARTBEAT_SECONDS=20

# Cloudflare Access origin verification. The audience is the Access
# application AUD value; the team domain is normally https://<team>.cloudflareaccess.com.
BOTANIKA_ACCESS_REQUIRED=true
BOTANIKA_ACCESS_ALLOWED_EMAIL=kisoreabhinav@gmail.com
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://YOUR-TEAM.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=REPLACE_WITH_ACCESS_APPLICATION_AUD
# Optional; otherwise it is derived from the team domain above.
# CLOUDFLARE_ACCESS_JWKS_URL=https://YOUR-TEAM.cloudflareaccess.com/cdn-cgi/access/certs
BOTANIKA_CSRF_REQUIRED=true
