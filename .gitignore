# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.eggs/
*.egg-info/
.venv/
venv/

# Web tooling
node_modules/
frontend/dist/
frontend/.vite/
coverage/

# Secrets and environment-specific configuration
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Runtime state and user-generated media
data/database/*.db
data/database/*.db-*
data/database/*.sqlite
data/database/*.sqlite-*
data/media/discoveries/*
!data/media/discoveries/.gitkeep
data/media/temp/*
!data/media/temp/.gitkeep
# Local campus-photo uploads and their raw extraction are operator data, not
# source assets. Keep this exact root-level upload name out of Git.
/Campus Flora.zip
/Campus Flora/
logs/
runtime/

# Large model and knowledge artifacts (keep manifests/README files)
models/**/*.onnx
models/**/*.tflite
models/**/*.pt
models/**/*.pth
models/**/*.gguf
models/**/*.bin
# Operator-supplied campus photos and generated enrollment artifacts stay
# local; only the privacy-safe review manifest is tracked.
/data/campus/enrollment/
/data/campus/.enrollment.staging-*
/models/plant_classifier/campus-fewshot-v1.json
/models/plant_classifier/campus-fewshot-v1.json.sha256
data/knowledge/*.jsonl
data/knowledge/*.parquet
data/vectors/*
!data/vectors/.gitkeep

# OS/editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Private planning material is kept locally but is not part of the public repo.
/.local/project-notes/
